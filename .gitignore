###########################################################
#                GLOBAL JAVA / MAVEN                      #
###########################################################

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Java crash logs
hs_err_pid*
replay_pid*

###########################################################
#                      MAVEN                               #
###########################################################

# Maven target directory (all modules)
target/
*/target/

# Maven backup files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Maven Wrapper
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/MavenWrapperDownloader.java

###########################################################
#                SPRING BOOT CONFIG FILES                 #
###########################################################

# Ignore application files containing sensitive data
application.properties
application.yml
application-*.properties
application-*.yml

# Uncomment if you want to track config in Git:
# !src/main/resources/application.properties
# !src/main/resources/application.yml

